# Template for arr/.env (the real file is encrypted with git-secret, see
# docs/arr-guest-plan.md). Copy the VPN, qBittorrent and Homarr values from the
# .env on heimdall. HOMARR_SECRET_KEY must be identical to heimdall's value,
# otherwise Homarr cannot decrypt the integration secrets it has stored.

TZ=Europe/Paris
INSTALL_TYPE=service

# Same paths as on heimdall, so no path inside any app config changes.
DATA_DIR=/mnt/dataYmir
DOCKER_CONFIG_DIR=/docker/appdata

# No optional profile: jellyfin runs in its own guest. Keep this empty.
COMPOSE_PROFILES=

# Only used by the services that are switched off in docker-compose.override.yml
# (traefik). Compose still resolves the variables, so keep them defined.
HOSTNAME=arr
DOMAIN=kornoglab.fr
CERTS_DIR=/nonexistent

# Homarr (copy from heimdall, do not generate a new one)
HOMARR_SECRET_KEY=

# VPN (gluetun)
VPN_TYPE=wireguard
SERVER_COUNTRIES=Netherlands,Switzerland,Sweden
WIREGUARD_PRIVATE_KEY=
OPENVPN_USER=
OPENVPN_PASSWORD=
GLUETUN_API_KEY=

# qBittorrent and its watchdog
QBT_USER=
QBT_PASS=
QBT_API_KEY=
QBT_AUTH_MODE=auto
