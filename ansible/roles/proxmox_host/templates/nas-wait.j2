#!/bin/bash
# {{ ansible_managed }}
# Waits until each NAS unit accepts a TCP connection (NFS 2049, SMB 445), for at most
# {{ proxmox_host_nas_wait_timeout | int }} s, then exits 0 in every case. The mounts come after it (x-systemd.requires in
# /etc/fstab). Why: network-online.target is reached when ifupdown2 has configured the bond,
# before the LACP partner answers, so a mount started right then fails (2026-11-24: CIFS error
# 113, NFS timeout). A NAS that stays down costs at most the timeout at boot, nothing more.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
TIMEOUT={{ proxmox_host_nas_wait_timeout | int }}
{% set nas_targets = [nfs_data.src.split(':')[0] ~ ':2049'] %}
{% for h in cifs_mounts | default([]) | map(attribute='src') | map('regex_replace', '^//([^/]+)/.*$', '\\1') | unique %}
{% set _ = nas_targets.append(h ~ ':445') %}
{% endfor %}
pending=({% for t in nas_targets | unique %}"{{ t }}" {% endfor %})
log() { logger -t nas-wait -p daemon.notice -- "$*"; }
while :; do
  next=()
  for t in "${pending[@]}"; do
    if timeout 3 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "${t%:*}" "${t##*:}" 2>/dev/null; then
      log "$t answers after $SECONDS s"
    else
      next+=("$t")
    fi
  done
  pending=("${next[@]}")
  if [[ -z "${pending[*]:-}" ]]; then exit 0; fi
  if ((SECONDS >= TIMEOUT)); then
    log "giving up after $SECONDS s, no answer from: ${pending[*]}"
    exit 0
  fi
  sleep 3
done
