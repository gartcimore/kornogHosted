# OVH API credentials
# Create a token at https://api.ovh.com/createToken/
# Required rights: GET/PUT/POST/DELETE on /domain/zone/*
OVH_AK=your_application_key
OVH_AS=your_application_secret
OVH_CK=your_consumer_key

# Synology DSM deploy hook
# Used to auto-import renewed certs into DSM
# User must be an administrator
SYNO_Username=your_synology_admin_username
SYNO_Password=your_synology_admin_password
SYNO_Scheme=https
SYNO_Hostname=192.168.0.54
SYNO_Port=5001
SYNO_Certificate=kornoglab.fr
SYNO_Create=1
# Skip SSL verification (DSM uses self-signed cert)
SYNO_Insecure=1
