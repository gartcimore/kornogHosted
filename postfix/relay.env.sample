# Do not edit by hand: run postfix/set-relay-secret.sh, which asks for the two values without echo.
# Then: git secret add postfix/relay.env && git secret hide
# Mail relay login used by roles/postfix_relay on orisa. Keep it out of git in plain form.
# RELAY_USER is the full mailbox address and is also the sender address of all mail from orisa.
RELAY_USER=
RELAY_PASSWORD=
