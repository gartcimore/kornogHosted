# Copy to infisical.secrets.env and fill in values

# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string pointing to the shared postgres service
# Adjust host/port/password to match your postgres setup
DB_CONNECTION_URI=postgres://postgres:YOUR_PG_PASSWORD@host.docker.internal:15432/infisical

# Valkey connection string pointing to the shared valkey service
REDIS_URL=redis://host.docker.internal:6379
